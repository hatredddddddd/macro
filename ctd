-- Cameraman Tower Defense macro for Matcha
--
-- QUICK START (all in the "CTD Macro" menu tab)
--   1. Stand where you want your starter towers, click "Slot 5 - create place here".
--   2. Stand at your mid-game area, click "Slot 1 - create place here".
--   3. Click Start (or press F8). Done.
--
-- "Towers per click" sliders set how many towers each button records (slot 1 = 9, slot 5 = 2).

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local CFG = {
    SlotKeys    = { 0x31, 0x32, 0x33, 0x34, 0x35, 0x36 },  -- hotbar keys 1-6
    UpgradeKey  = 0x45,                                    -- "E"
    CancelKey   = nil,                                     -- Q deletes units in this game, so no cancel key is pressed
    StarterSlot = 5,                                       -- always placed first
    -- how many towers one F-key press records (placed in a grid around you)
    Counts      = { [1] = 9, [2] = 1, [3] = 1, [4] = 1, [5] = 2, [6] = 1 },
    -- placement cost per slot
    Costs       = { [1] = 300, [2] = 1000, [3] = 1000, [4] = 200, [5] = 180 },
    SpotsFile   = "ctd_spots.txt",
    ReplayWords = { "replay", "play again", "retry", "restart" },
}

local settings = {
    spacing = 4,          -- studs between towers in a recorded group
    placeDelay = 1,       -- seconds after each placement
    upgradeEvery = 4,     -- seconds between upgrade passes
    upgradesPerPass = 1,
    roundDelay = 6,       -- seconds to wait after clicking replay
    insetY = 58,          -- GUI inset for the replay click
    autostart = false,    -- start the macro automatically when the script loads
    afkMode = false,      -- master switch: turns on everything needed to farm unattended
    useRemotes = true,    -- allow the ChangeSpeed / PlayAgain remotes (turn off to use button clicks only)
    groupMode = false,    -- false: one tower exactly where you stand; true: auto-grid groups
    groundOffset = 3,     -- studs below your character's center where the placement click lands
    tpSet = false,        -- a teleport spot has been saved
    tpX = 0, tpY = 0, tpZ = 0,
    tpEnabled = false,    -- teleport to the spot at the start of each round
    autoSkip = false,     -- click the "skip wave" button when it shows
    useReplayRemote = true, -- fire the PlayAgain remote instead of clicking the Replay button
    modeVoteEnabled = false, -- vote for a mode by clicking its Vote button at round start
    modeVoteMode = 3,     -- 1 Easy, 2 Normal, 3 Hard, 4 Insane, 5 Nightmare
    modeVoteOffX = 400,   -- pixel nudge added to the calculated click position
    modeVoteOffY = 0,
    modeVoteClicks = 1,   -- how many times to click the Vote button
    modeVoteAfter = 8,    -- seconds after joining the server / starting a round before voting
    timedPlayAgain = true, -- fire PlayAgain on a timer instead of waiting for the Replay button
    playAgainAfter = 386, -- seconds after the round starts (386 = 6:26)
    unloadOnNewServer = false, -- unload completely on a new server so autoexec can run a fresh copy
    autoSpeed = false,    -- set game speed (default 1.5x) through the ChangeSpeed remote
    gameSpeed = 1.5,      -- speed value sent to the remote
    skipEvery = 2,        -- seconds between skip checks
    camSet = false,       -- a camera view has been saved
    camPX = 0, camPY = 0, camPZ = 0,   -- saved camera position
    camLX = 0, camLY = 0, camLZ = -1,  -- saved camera look direction
    camFov = 0,           -- saved field of view (0 = don't change)
    camEnabled = false,   -- restore the camera view at round start and before placing
    camLock = false,      -- hold the saved camera view constantly (fixed camera)
    camAuto = true,       -- input-based camera reset: zoom all the way out, then look down
    zoomNotches = 20,     -- scroll-wheel notches used to zoom out
    pitchDrag = 600,      -- pixels of right-mouse drag used to tilt the camera down
    zoomReverse = false,  -- flip scroll direction if the camera zooms in instead
    pitchReverse = false, -- flip drag direction if the camera looks up instead
    pitchAbs = false,     -- drag with absolute mouse moves instead of relative ones
}

local spots = {}    -- { slot, pos, placed }
local history = {}  -- group sizes, for undo
local running = false
local status = "Idle"
local roundStart = tick()  -- when this server/round began (script load, new server, or replay)
local voteDone = false     -- mode vote already sent for this round
local runGen = 0           -- bumps on every start so an old loop can't keep running

-- instance guard: a copy of the script stops its own loops when a newer copy has loaded.
-- this only compares a number, it never calls anything left over from an old copy,
-- so restarting the LuaVM can't run stale code.
local alive = true
_G.__CTD_INSTANCE = (tonumber(_G.__CTD_INSTANCE) or 0) + 1
local instanceId = _G.__CTD_INSTANCE
local function isAlive()
    return alive and _G.__CTD_INSTANCE == instanceId
end

local wantRunning = false  -- the user wants the macro on (so it can be restarted if it stalls)
local lastBeat = tick()    -- last time the main loop proved it is alive

local function unload()
    alive = false
    wantRunning = false
    running = false
    runGen = runGen + 1
    status = "Unloaded"
    pcall(notify, "CTD Macro unloaded", "CTD Macro", 3)
end

---------------------------------------------------------------- persistence
local function saveSpots()
    local lines = {}
    for _, s in ipairs(spots) do
        lines[#lines + 1] = string.format("%d,%.3f,%.3f,%.3f", s.slot, s.pos.X, s.pos.Y, s.pos.Z)
    end
    local ok, err = pcall(writefile, CFG.SpotsFile, table.concat(lines, "\n"))
    if not ok then notify("Could not save spots: " .. tostring(err), "CTD Macro", 5) end
end

local function loadSpots()
    local loaded = {}
    local ok, err = pcall(function()
        if not isfile(CFG.SpotsFile) then return end
        local text = readfile(CFG.SpotsFile)
        for line in text:gmatch("[^\r\n]+") do
            -- tolerant parse: grab the 4 numbers on the line (slot, x, y, z)
            local nums = {}
            for tok in line:gmatch("[%-%+]?[%d]+%.?[%d]*") do nums[#nums + 1] = tonumber(tok) end
            if #nums >= 4 and nums[1] and nums[2] and nums[3] and nums[4] then
                loaded[#loaded + 1] = { slot = math.floor(nums[1]), pos = Vector3.new(nums[2], nums[3], nums[4]), placed = false }
            end
        end
    end)
    if not ok then
        notify("Could not read saved spots: " .. tostring(err), "CTD Macro", 5)
        return 0
    end
    spots = loaded
    return #spots
end

local loadedCount = loadSpots()

---------------------------------------------------------------- config file
-- ctd_config.cfg stores your settings, tower counts and auto-start choice.
-- ctd_spots.txt stores your recorded places. Both load automatically.
local CONFIG_FILE = "ctd_config.cfg"

local function saveConfig()
    local lines = {}
    for k, v in pairs(settings) do
        lines[#lines + 1] = k .. "=" .. tostring(v)
    end
    for i = 1, 5 do
        lines[#lines + 1] = "count" .. i .. "=" .. tostring(CFG.Counts[i] or 1)
    end
    local ok, err = pcall(writefile, CONFIG_FILE, table.concat(lines, "\n"))
    if not ok then notify("Could not save config: " .. tostring(err), "CTD Macro", 5) end
end

local function loadConfig()
    pcall(function()
        if not isfile(CONFIG_FILE) then return end
        for line in readfile(CONFIG_FILE):gmatch("[^\r\n]+") do
            local k, v = line:match("^(%w+)=(.+)$")
            if k then
                local idx = k:match("^count(%d)$")
                if idx then
                    CFG.Counts[tonumber(idx)] = tonumber(v) or CFG.Counts[tonumber(idx)]
                elseif settings[k] ~= nil then
                    if type(settings[k]) == "boolean" then
                        settings[k] = (v == "true")
                    elseif type(settings[k]) == "string" then
                        settings[k] = v
                    else
                        settings[k] = tonumber(v) or settings[k]
                    end
                end
            end
        end
    end)
    settings.camLock = false -- camera writes don't work here, so the saved-view feature is off for good
    settings.camEnabled = false
end

loadConfig()

local function countBySlot(slot)
    local n = 0
    for _, s in ipairs(spots) do if s.slot == slot then n = n + 1 end end
    return n
end

---------------------------------------------------------------- input helpers
local function tap(key)
    keypress(key)
    wait(0.05)
    keyrelease(key)
end

local function clickAt(x, y)
    mousemoveabs(math.floor(x), math.floor(y))
    wait(0.08)
    mouse1click()
end

local function clickWorld(pos)
    local sp, on = WorldToScreen(pos)
    if not on then return false end
    clickAt(sp.X, sp.Y)
    return true
end

---------------------------------------------------------------- cash
local function getCash()
    local ok, val = pcall(function()
        local ls = LocalPlayer:FindFirstChild("leaderstats")
        local m = ls and ls:FindFirstChild("Money")
        return m and m.Value
    end)
    if ok and type(val) == "number" then return val end
    return nil
end

---------------------------------------------------------------- recording
local function myRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

-- after joining a server, wait until the character has loaded before starting anything
local function waitForCharacter(timeout)
    local t0 = tick()
    while tick() - t0 < timeout do
        local ok, root = pcall(myRoot)
        if ok and root then return true end
        wait(0.5)
    end
    return false
end

-- towers can't share a spot: nudge a new position to the nearest free grid cell
local function isFree(pos)
    for _, s in ipairs(spots) do
        local d = Vector3.new(s.pos.X - pos.X, 0, s.pos.Z - pos.Z).Magnitude
        if d < settings.spacing * 0.9 then return false end
    end
    return true
end

local function findFree(pos)
    if isFree(pos) then return pos end
    local step = settings.spacing
    for ring = 1, 8 do
        for i = -ring, ring do
            for j = -ring, ring do
                if math.max(math.abs(i), math.abs(j)) == ring then
                    local p = pos + Vector3.new(i * step, 0, j * step)
                    if isFree(p) then return p end
                end
            end
        end
    end
    return pos
end

local function recordGroup(slot)
    local hrp = myRoot()
    if not hrp then notify("No character found", "CTD Macro", 3) return end
    local n = settings.groupMode and (CFG.Counts[slot] or 1) or 1
    local base = hrp.Position -- exact coordinates of your character
    local cols = math.ceil(math.sqrt(n))
    local rows = math.ceil(n / cols)
    for i = 0, n - 1 do
        local c = i % cols
        local r = math.floor(i / cols)
        local dx = (c - (cols - 1) / 2) * settings.spacing
        local dz = (r - (rows - 1) / 2) * settings.spacing
        local want = base + Vector3.new(dx, 0, dz)
        if settings.groupMode then
            want = findFree(want)
        elseif not isFree(want) then
            notify("Warning: very close to another tower", "CTD Macro", 3)
        end
        spots[#spots + 1] = { slot = slot, pos = want, placed = false }
    end
    history[#history + 1] = n
    saveSpots()
    notify("Recorded " .. n .. "x slot " .. slot, "CTD Macro", 3)
end

local function undoGroup()
    local n = table.remove(history)
    if not n then
        -- no history this session: remove one spot
        n = math.min(1, #spots)
    end
    for _ = 1, n do table.remove(spots) end
    saveSpots()
    notify("Undid last record (" .. #spots .. " spots left)", "CTD Macro", 2)
end

local function clearAll()
    spots, history = {}, {}
    saveSpots()
    notify("All spots cleared", "CTD Macro", 2)
end

---------------------------------------------------------------- game actions
-- camera view: save where the camera is now, restore it later
local camWarned = false

local function saveCamera()
    local saved = false
    pcall(function()
        local cam = workspace.CurrentCamera
        local cf = cam.CFrame
        local p, l = cf.Position, cf.LookVector
        settings.camPX, settings.camPY, settings.camPZ = p.X, p.Y, p.Z
        settings.camLX, settings.camLY, settings.camLZ = l.X, l.Y, l.Z
        saved = true
    end)
    pcall(function() settings.camFov = workspace.CurrentCamera.FieldOfView end)
    if saved then
        settings.camSet = true
        saveConfig()
        notify("Camera view saved", "CTD Macro", 2)
    else
        notify("Couldn't read the camera in Matcha", "CTD Macro", 4)
    end
end

-- Sets the saved camera view. You found that it only works after you nudge the camera a
-- little by hand, so with full=true this does that nudge itself (a tiny right-click drag)
-- and retries a few times. The camera object is fetched fresh on every attempt, in case the
-- old reference went stale after spawning or a server change.
-- This is a one-off write per round, not a constant lock.
local function applyCamera(full)
    if not settings.camSet then return false end
    local target = Vector3.new(settings.camPX, settings.camPY, settings.camPZ)
    local look = Vector3.new(settings.camLX, settings.camLY, settings.camLZ)
    local attempts = full and 5 or 1
    for _ = 1, attempts do
        if full then
            pcall(function()
                pcall(setrobloxinput, true)
                mouse2press()
                wait(0.15)
                mousemoverel(0, 3)
                wait(0.05)
                mousemoverel(0, -3)
                wait(0.1)
                mouse2release()
            end)
            wait(0.3)
        end
        pcall(function()
            local cam = game:GetService("Workspace").CurrentCamera
            pcall(function() cam.CameraType = Enum.CameraType.Scriptable end)
            cam.CFrame = CFrame.new(target, target + look)
            if settings.camFov > 0 then cam.FieldOfView = settings.camFov end
        end)
        wait(0.2)
        local good = false
        pcall(function()
            local p = game:GetService("Workspace").CurrentCamera.CFrame.Position
            good = (p - target).Magnitude < 3
        end)
        if good then return true end
    end
    if not camWarned then
        camWarned = true
        notify("Camera still didn't move after retrying - the game may be controlling it.", "CTD Macro", 6)
    end
    return false
end

-- fixed camera: while camLock is on, keep forcing the saved view many times a second
task.spawn(function()
    local wasLocked = false
    while false do -- camera lock removed: writing the camera 30x a second can crash Roblox
        if settings.camLock and settings.camSet then
            pcall(function()
                local cam = workspace.CurrentCamera
                if not wasLocked then
                    pcall(function() cam.CameraType = Enum.CameraType.Scriptable end)
                    wasLocked = true
                end
                local p = Vector3.new(settings.camPX, settings.camPY, settings.camPZ)
                local l = Vector3.new(settings.camLX, settings.camLY, settings.camLZ)
                cam.CFrame = CFrame.new(p, p + l)
                if settings.camFov > 0 then cam.FieldOfView = settings.camFov end
            end)
        elseif wasLocked then
            wasLocked = false
            pcall(function() workspace.CurrentCamera.CameraType = Enum.CameraType.Custom end)
        end
        wait(0.03)
    end
    if wasLocked then pcall(function() workspace.CurrentCamera.CameraType = Enum.CameraType.Custom end) end
end)

-- auto camera: works through plain mouse input, so it needs no camera write access.
-- zooming fully out and tilting to the pitch limit gives the same view every time.
local function offscreenCount()
    local off = 0
    for _, s in ipairs(spots) do
        local _, on = WorldToScreen(s.pos - Vector3.new(0, settings.groundOffset, 0))
        if not on then off = off + 1 end
    end
    return off
end

local function normalizeCamera(force)
    if not force and not settings.camAuto then return end
    -- a saved camera view takes priority over the zoom-out / look-down reset
    if not force and settings.camEnabled and settings.camSet then return end
    local zdir = settings.zoomReverse and 1 or -1 -- wheel down = zoom out
    for _ = 1, settings.zoomNotches do
        mousescroll(zdir)
        wait(0.03)
    end
    wait(0.2)
    if settings.pitchDrag > 0 then
        local pdir = settings.pitchReverse and -1 or 1 -- mouse down = look down
        -- make sure injected mouse input is allowed to reach the game
        pcall(setrobloxinput, true)
        -- start from the middle of the window so the drag isn't over a button or menu
        local vw, vh = 1920, 1080
        pcall(function()
            local vs = workspace.CurrentCamera.ViewportSize
            if vs.X > 0 and vs.Y > 0 then vw, vh = vs.X, vs.Y end
        end)
        local cx, cy = math.floor(vw / 2), math.floor(vh / 2)
        mousemoveabs(cx, cy)
        wait(0.2)
        mouse2press()
        wait(0.3) -- let Roblox lock the cursor and start a camera drag
        -- many small moves: Roblox turns each frame's movement into rotation, so one big jump is ignored
        local step = 8
        local steps = math.max(1, math.floor(settings.pitchDrag / step))
        if settings.pitchAbs then
            for i = 1, steps do
                mousemoveabs(cx, cy + pdir * i * step)
                wait(0.02)
            end
        else
            mousemoverel(0, pdir) -- tiny first nudge to start the drag
            wait(0.05)
            for _ = 1, steps do
                mousemoverel(0, pdir * step)
                wait(0.02)
            end
        end
        wait(0.2)
        mouse2release()
        wait(0.1)
        mousemoveabs(cx, cy)
    end
    wait(0.3)
    local off = offscreenCount()
    if #spots > 0 and off > 0 then
        notify(off .. " of " .. #spots .. " spots are off screen - zoom out more or move your spots closer", "CTD Macro", 6)
    end
end

local tpWarned = false
local function teleportHome()
    if not settings.tpSet then return false end
    local hrp = myRoot()
    if not hrp then return false end
    local target = Vector3.new(settings.tpX, settings.tpY, settings.tpZ)
    pcall(function() hrp.CFrame = CFrame.new(target.X, target.Y, target.Z) end)
    wait(0.3)
    local now = myRoot()
    local moved = now and (now.Position - target).Magnitude < 8
    if not moved and not tpWarned then
        tpWarned = true
        notify("Teleport didn't move you - Matcha may not allow it. Walk to your spot manually.", "CTD Macro", 6)
    end
    return moved and true or false
end

local function placeSpot(s)
    if settings.camEnabled then applyCamera() end
    local key = CFG.SlotKeys[s.slot]
    if not key then return end
    tap(key)
    wait(0.2)
    if clickWorld(s.pos - Vector3.new(0, settings.groundOffset, 0)) then
        s.placed = true
        wait(0.3)
        if CFG.CancelKey then tap(CFG.CancelKey) end
    end
end

local function upgradeSpot(s, times)
    if clickWorld(s.pos) then
        wait(0.15)
        for _ = 1, times do
            tap(CFG.UpgradeKey)
            wait(0.12)
        end
    end
end

