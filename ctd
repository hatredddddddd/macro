-- AFK farm mode: one switch that turns on everything the macro needs to run unattended,
-- and makes it start itself every time the script loads or a new server is joined.
local function applyAfkMode(on)
    settings.afkMode = on
    local function setToggle(id, key, value)
        settings[key] = value
        pcall(UI.SetValue, id, value)
    end
    if on then
        setToggle("ctd_autostart", "autostart", true)
        setToggle("ctd_cam_auto", "camAuto", true)
        setToggle("ctd_mode_vote", "modeVoteEnabled", true)
        setToggle("ctd_timed_play", "timedPlayAgain", true)
        setToggle("ctd_autoskip", "autoSkip", true)
        setToggle("ctd_autospeed", "autoSpeed", true)
        setToggle("ctd_replay_remote", "useReplayRemote", true)
        if settings.tpSet then
            setToggle("ctd_tp_enabled", "tpEnabled", true)
        else
            notify("AFK mode: also set a teleport spot so it returns there on every join", "CTD Macro", 6)
        end
        if #spots == 0 then
            notify("AFK mode: create your tower places first", "CTD Macro", 5)
        end
    else
        setToggle("ctd_autostart", "autostart", false)
    end
    saveConfig()
    if on and #spots > 0 and not running then
        task.spawn(function() setRunning(true) end)
    end
end

-- edits to individual places are queued and applied at the start of the next frame
local pending = nil

local function applyPending()
    if not pending then return end
    local kind, i = pending[1], pending[2]
    pending = nil
    if not spots[i] then return end
    if kind == "delete" then
        table.remove(spots, i)
    elseif kind == "move" then
        local hrp = myRoot()
        if not hrp then notify("No character found", "CTD Macro", 3) return end
        spots[i].pos = hrp.Position
        notify("Moved #" .. i .. " to where you stand", "CTD Macro", 2)
    elseif kind == "up" and i > 1 then
        spots[i], spots[i - 1] = spots[i - 1], spots[i]
    end
    history = {}
    saveSpots()
end

