---------------------------------------------------------------- main loop
-- find a visible GUI element whose (lowercased) text satisfies matchFn
local function isShown(d)
    local node = d
    for _ = 1, 12 do
        if not node then break end
        local ok, hidden = pcall(function()
            if node:IsA("GuiObject") then return not node.Visible end
            return node.Enabled == false
        end)
        if ok and hidden then return false end
        node = node.Parent
    end
    return true
end

-- Walking the whole GUI tree is the heaviest thing this script does, and it reads Roblox's
-- memory from outside. So it is done at most once every few seconds and shared by every
-- feature (replay, skip, speed, vote, round start clicks) instead of once per feature per loop.
local SNAPSHOT_EVERY = 4
local guiSnap, guiSnapAt = {}, 0

local function snapshotGui()
    if tick() - guiSnapAt < SNAPSHOT_EVERY then return guiSnap end
    guiSnapAt = tick()
    local list = {}
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if gui then
        local ok, descendants = pcall(function() return gui:GetDescendants() end)
        if ok and descendants then
            for _, d in ipairs(descendants) do
                pcall(function()
                    if d:IsA("GuiObject") then
                        local t = d.Text
                        if t and t ~= "" then
                            list[#list + 1] = { obj = d, text = string.lower(t) }
                        end
                    end
                end)
            end
        end
    end
    guiSnap = list
    return list
end

local function findGuiText(matchFn)
    for _, entry in ipairs(snapshotGui()) do
        local ok, hit = pcall(function()
            return matchFn(entry.text) and isShown(entry.obj)
        end)
        if ok and hit then return entry.obj end
    end
    return nil
end

local function findReplayButton()
    return findGuiText(function(t)
        for _, w in ipairs(CFG.ReplayWords) do
            if t:find(w, 1, true) then return true end
        end
        return false
    end)
end

local function clickGui(d)
    local p, s = d.AbsolutePosition, d.AbsoluteSize
    clickAt(p.X + s.X / 2, p.Y + s.Y / 2 + settings.insetY)
end

local lastSkip, lastSpeed, speedTries = 0, 0, 0
local speedDone, speedRemoteTried, speedWarned = false, 0, false

-- mode vote by clicking the Vote button (the ModeVote remote didn't work).
-- the five Vote buttons sit at fixed fractions of the window, measured on a 2576x1068 screenshot:
--   Easy 608, Normal 946, Hard 1284, Insane 1621, Nightmare 1959 (x), 697 (y)
local MODE_NAMES = { "Easy", "Normal", "Hard", "Insane", "Nightmare" }
local VOTE_RX = { 0.2360, 0.3672, 0.4984, 0.6293, 0.7605 }
local VOTE_RY = 0.6526
local lastVoteTry = 0

local function voteTarget()
    local vw, vh = 1920, 1080
    pcall(function()
        local vs = workspace.CurrentCamera.ViewportSize
        if vs.X > 0 and vs.Y > 0 then vw, vh = vs.X, vs.Y end
    end)
    local i = math.max(1, math.min(5, math.floor(settings.modeVoteMode)))
    return vw * VOTE_RX[i] + settings.modeVoteOffX, vh * VOTE_RY + settings.modeVoteOffY
end

-- returns true once the click was sent, false if the voting screen isn't up yet (it tries again)
local function fireModeVote(force)
    if not force then
        if not settings.modeVoteEnabled then return false end
        if tick() - lastVoteTry < 2 then return false end
        lastVoteTry = tick()
        -- only click while a "Vote" button is actually on screen
        local b = findGuiText(function(t) return t:match("^%s*vote%s*$") ~= nil end)
        if not b then return false end
    end
    -- clicks only land while Roblox is the active window
    for _ = 1, 10 do
        if isrbxactive() then break end
        wait(1)
    end
    status = "Voting " .. MODE_NAMES[settings.modeVoteMode]
    local ok = pcall(function()
        for n = 1, settings.modeVoteClicks do
            local x, y = voteTarget()
            clickAt(x, y)
            if n < settings.modeVoteClicks then wait(0.6) end
        end
    end)
    return ok
end

-- the vote itself is sent by the main loop, modeVoteAfter seconds after the server/round starts
local function voteMode()
    voteDone = false
end

-- game.ReplicatedStorage.ModuleLoader.Shared.Network.RemoteEvent.PlayAgain:FireServer()
local playWarned = false
local function firePlayAgain()
    if not settings.useRemotes then return false end
    local ok, err = pcall(function()
        local node = game:GetService("ReplicatedStorage")
        for _, name in ipairs({ "ModuleLoader", "Shared", "Network", "RemoteEvent", "PlayAgain" }) do
            node = node:FindFirstChild(name)
            if not node then error("missing " .. name) end
        end
        node:FireServer()
    end)
    if not ok and not playWarned then
        playWarned = true
        notify("PlayAgain remote failed (" .. tostring(err) .. "), clicking the button instead", "CTD Macro", 6)
    end
    return ok
end

-- game.Players.<you>.PlayerGui.GameUI.Stats.WaveSkipGui (the skip wave button)
local function getWaveSkipButton()
    local node
    local ok = pcall(function()
        node = LocalPlayer:FindFirstChild("PlayerGui")
        for _, name in ipairs({ "GameUI", "Stats", "WaveSkipGui" }) do
            node = node and node:FindFirstChild(name)
        end
    end)
    if ok and node and isShown(node) then return node end
    return nil
end

-- game.ReplicatedStorage.ModuleLoader.Shared.Network.RemoteFunction.ChangeSpeed:InvokeServer(1.5)
local SPEED_REMOTE_PATH = { "ModuleLoader", "Shared", "Network", "RemoteFunction", "ChangeSpeed" }

local function setSpeedRemote()
    if not settings.useRemotes then return false end
    local ok, err = pcall(function()
        local node = game:GetService("ReplicatedStorage")
        for _, name in ipairs(SPEED_REMOTE_PATH) do
            node = node:FindFirstChild(name)
            if not node then error("missing " .. name) end
        end
        node:InvokeServer(settings.gameSpeed)
    end)
    if not ok and not speedWarned and speedRemoteTried >= 3 then
        speedWarned = true
        notify("Speed remote failed (" .. tostring(err) .. "), falling back to button click", "CTD Macro", 6)
    end
    return ok
end

local function autoUtilities()
    -- 1.5x speed: find the speed button (text like "1x", "1.5x", "2x") and click until it reads 1.5x
    if settings.autoSpeed and not speedDone and speedRemoteTried < 3 then
        speedRemoteTried = speedRemoteTried + 1
        if setSpeedRemote() then
            speedDone = true
            status = "Speed set to " .. tostring(settings.gameSpeed) .. "x"
        else
            wait(1)
        end
    end
    -- fallback: click a speed button in the GUI if the remote didn't work
    if settings.autoSpeed and not speedDone and speedRemoteTried >= 3 and tick() - lastSpeed >= 3 then
        lastSpeed = tick()
        local b = findGuiText(function(t)
            return t:match("^%s*%d+%.?%d*%s*x%s*$") or t:match("^%s*x%s*%d+%.?%d*%s*$")
        end)
        if b then
            local t = string.lower(b.Text)
            if t:find("1.5", 1, true) then
                speedTries = 0
            elseif speedTries < 3 then
                status = "Setting 1.5x speed"
                clickGui(b)
                speedTries = speedTries + 1
                wait(0.3)
            end
        end
    end
    -- skip wave
    if settings.autoSkip and tick() - lastSkip >= settings.skipEvery then
        lastSkip = tick()
        local b = getWaveSkipButton() or findGuiText(function(t) return t:find("skip", 1, true) ~= nil end)
        if b then
            status = "Skipping wave"
            clickGui(b)
            wait(0.2)
        end
    end
end

---------------------------------------------------------------- round start clicks
-- things to click when the macro starts and after each Replay (e.g. a "Start" / "Ready" button).
-- text targets find a visible button by its text; position targets click a screen pixel.
local clickTargets = {}
local CLICKS_FILE = "ctd_clicks.txt"
local pendingClickDel = nil
local newClickText = ""

local function saveClicks()
    local lines = {}
    for _, c in ipairs(clickTargets) do
        if c.kind == "text" then
            lines[#lines + 1] = "text|" .. c.text
        else
            lines[#lines + 1] = string.format("pos|%d|%d", c.x, c.y)
        end
    end
    local ok, err = pcall(writefile, CLICKS_FILE, table.concat(lines, "\n"))
    if not ok then notify("Could not save click targets: " .. tostring(err), "CTD Macro", 5) end
end

local function loadClicks()
    clickTargets = {}
    pcall(function()
        if not isfile(CLICKS_FILE) then return end
        for line in readfile(CLICKS_FILE):gmatch("[^\r\n]+") do
            local txt = line:match("^text|(.+)$")
            local px, py = line:match("^pos|([%-%d%.]+)|([%-%d%.]+)$")
            if txt then
                clickTargets[#clickTargets + 1] = { kind = "text", text = txt }
            elseif px and py then
                clickTargets[#clickTargets + 1] = { kind = "pos", x = tonumber(px), y = tonumber(py) }
            end
        end
    end)
end

loadClicks()

local function runRoundStartClicks(force)
    for _, c in ipairs(clickTargets) do
        if not force and not running then return end
        if c.kind == "pos" then
            clickAt(c.x, c.y)
        else
            local needle = string.lower(c.text)
            local b
            for _ = 1, 10 do -- wait up to ~5s for the button to appear
                b = findGuiText(function(t) return t:find(needle, 1, true) ~= nil end)
                if b or (not force and not running) then break end
                wait(0.5)
            end
            if b then clickGui(b) end
        end
        wait(0.5)
    end
end

local function captureMouse()
    notify("Move your mouse over the target - capturing in 3s", "CTD Macro", 3)
    wait(3)
    local ok, pos = pcall(function() return game:GetService("UserInputService"):GetMouseLocation() end)
    if ok and pos then
        clickTargets[#clickTargets + 1] = { kind = "pos", x = pos.X, y = pos.Y }
        saveClicks()
        notify(string.format("Saved click position (%d, %d)", pos.X, pos.Y), "CTD Macro", 3)
    else
        notify("Matcha can't read the mouse position - add a text target instead", "CTD Macro", 5)
    end
end

local function mainLoopBody()
    local lastUpgrade = 0
    local myGen = runGen
    if settings.tpEnabled then teleportHome() wait(1) end
    if settings.camEnabled then applyCamera(true) end
    normalizeCamera()
    voteMode()
    runRoundStartClicks()
    while running and myGen == runGen and isAlive() do
        lastBeat = tick()
        -- after a teleport the old player object can go stale, so grab it again
        pcall(function()
            local lp = Players.LocalPlayer
            if lp then LocalPlayer = lp end
        end)
        -- timers that only use remotes, so they work even if the Roblox window isn't focused
        if settings.modeVoteEnabled and not voteDone and tick() - roundStart >= settings.modeVoteAfter then
            if fireModeVote() then
                voteDone = true
            elseif tick() - roundStart > settings.modeVoteAfter + 60 then
                voteDone = true -- the voting screen never showed up this round, stop looking
            end
        end
        if settings.timedPlayAgain and tick() - roundStart >= settings.playAgainAfter then
            status = "Timed PlayAgain"
            firePlayAgain()
            roundStart = tick()
            voteDone = false
            speedDone, speedRemoteTried, speedTries = false, 0, 0
            for _, sp in ipairs(spots) do sp.placed = false end
        end
        if isrbxactive() then
            local btn = findReplayButton()
            if btn then
                status = "Replaying..."
                if not (settings.useReplayRemote and firePlayAgain()) then
                    local p, s = btn.AbsolutePosition, btn.AbsoluteSize
                    clickAt(p.X + s.X / 2, p.Y + s.Y / 2 + settings.insetY)
                end
                for _, sp in ipairs(spots) do sp.placed = false end
                speedTries = 0 -- speed may reset each round
                speedDone, speedRemoteTried = false, 0
                roundStart = tick()
                voteDone = false
                wait(settings.roundDelay)
                if settings.tpEnabled then teleportHome() wait(1) end
                if settings.camEnabled then applyCamera(true) end
                normalizeCamera()
                voteMode()
                runRoundStartClicks()
            else
                autoUtilities()
                local didSomething = false
                -- starter slot first, then the rest in recorded order
                for pass = 1, 2 do
                    for _, sp in ipairs(spots) do
                        if not running then break end
                        local isStarter = (sp.slot == CFG.StarterSlot)
                        if not sp.placed and ((pass == 1) == isStarter) then
                            local cost = CFG.Costs[sp.slot]
                            local cash = getCash()
                            if cash and cost and cash < cost then
                                status = "Waiting for cash ($" .. cost .. ")"
                                wait(1)
                            else
                                status = "Placing slot " .. sp.slot
                                placeSpot(sp)
                                wait(settings.placeDelay)
                            end
                            didSomething = true
                            break
                        end
                    end
                    if didSomething then break end
                end
                if not didSomething and tick() - lastUpgrade >= settings.upgradeEvery then
                    status = "Upgrading"
                    for _, sp in ipairs(spots) do
                        if not running then break end
                        if sp.placed then upgradeSpot(sp, settings.upgradesPerPass) end
                    end
                    lastUpgrade = tick()
                elseif not didSomething then
                    status = "Running"
                end
            end
        end
        wait(0.5)
    end
    status = "Stopped"
end

-- runs the main loop, and if anything errors (nil objects right after a teleport, etc.)
-- it reports it and keeps going instead of silently dying
local lastErrNotify = 0
local function mainLoop()
    while running and isAlive() do
        local ok, err = pcall(mainLoopBody)
        if not ok then
            if tick() - lastErrNotify > 30 then
                lastErrNotify = tick()
                notify("Macro error (continuing): " .. tostring(err), "CTD Macro", 6)
            end
            wait(3)
        end
    end
    status = "Stopped"
end

local function setRunning(v)
    if v and not running then
        if #spots == 0 then notify("Create places first (Slot buttons)", "CTD Macro", 3) return end
        runGen = runGen + 1
        running = true
        wantRunning = true
        lastBeat = tick()
        notify("Macro started", "CTD Macro", 2)
        task.spawn(mainLoop)
    elseif not v and running then
        running = false
        wantRunning = false
        notify("Macro stopped", "CTD Macro", 2)
    end
end

