---------------------------------------------------------------- new server refresh
-- when the server changes (game.JobId differs), reload everything and restart the macro.
-- if Matcha clears the script on teleport, put the script in Matcha's autoexec so it
-- loads again, and turn on Auto-start.
local function currentJobId()
    -- the server id plus the place id, so joining a different game also counts as "new"
    local ok, id = pcall(function() return game.JobId end)
    local ok2, pid = pcall(function() return game.PlaceId end)
    local key = ((ok and type(id) == "string") and id or "") .. ":" .. tostring(ok2 and pid or "")
    if key == ":" then return nil end
    return key
end

local lastJob = currentJobId()

local function onNewServer()
    if settings.unloadOnNewServer then
        notify("New server detected - unloading so autoexec can reload", "CTD Macro", 4)
        unload()
        return
    end
    local wasRunning = wantRunning or running
    running = false
    status = "New server - refreshing"
    notify("New server detected - refreshing script", "CTD Macro", 4)
    wait(2)
    pcall(function() LocalPlayer = Players.LocalPlayer end)
    local backupSpots = spots
    loadConfig()
    loadSpots()
    loadClicks()
    -- if the file couldn't be read in the new server, keep the places we already had
    if #spots == 0 and #backupSpots > 0 then spots = backupSpots end
    history = {}
    for _, sp in ipairs(spots) do sp.placed = false end
    speedDone, speedRemoteTried, speedTries, speedWarned = false, 0, 0, false
    voteDone = false
    roundStart = tick() -- the vote and PlayAgain timers count from here
    if wasRunning or settings.autostart then
        wait(3)
        waitForCharacter(30)
        wait(2)
        setRunning(true)
    end
end

task.spawn(function()
    while alive do
        wait(1)
        local id = currentJobId()
        if id then
            if lastJob and id ~= lastJob then
                lastJob = id
                onNewServer()
            else
                lastJob = id
            end
        end
        -- watchdog: if the macro should be running but its loop stopped reporting in, restart it
        if wantRunning and isAlive() and tick() - lastBeat > 45 then
            lastBeat = tick()
            notify("Macro stalled - restarting it", "CTD Macro", 4)
            running = false
            wait(0.5)
            setRunning(true)
        end
    end
end)

